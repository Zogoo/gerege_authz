      "webOrigins": [
        "http://smarthome.local.test"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://smarthome.local.test/*"
      },
      "protocolMappers": [
        {
          "name": "assistant-agent-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "assistant-agent",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "sensor-1",
      "name": "sensor-1 (IoT device identity)",
