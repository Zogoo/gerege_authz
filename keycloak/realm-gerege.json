      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "sensor-1-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "assistant-agent",
      "name": "Assistant (AI agent)",
      "description": "A delegated actor. Obtains its identity by exchanging a user's token (RFC 8693); never runs a browser flow and holds no service account.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "assistant-agent-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "standard.token.exchange.enabled": "true"
      }
    }
  ]
