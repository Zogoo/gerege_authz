      "secret": "account-app-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://account.local.test/*"
      ],
      "webOrigins": [
        "http://account.local.test"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://account.local.test/*"
      }
    },
    {
      "clientId": "smarthome-app",
      "name": "Smart Home (third-party)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "smarthome-app-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
